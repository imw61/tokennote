{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "console",
  "description": "Permissions for console webview windows",
  "windows": ["console-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "dialog:default",
    "dialog:allow-ask",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "opener:default"
  ]
}
